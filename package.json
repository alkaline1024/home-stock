{
  "name": "home-stock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "pretest": "node scripts/build-app.mjs",
    "dev": "node scripts/local.mjs",
    "host": "node scripts/local.mjs --host",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "ocr:setup": "python3 -m venv services/openthai/.venv && services/openthai/.venv/bin/pip install -r services/openthai/requirements.txt && services/openthai/.venv/bin/python services/openthai/setup.py",
    "ocr:serve": "services/openthai/.venv/bin/python services/openthai/server.py",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/tha": "^1.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.8.2",
    "@vercel/speed-insights": "^2.1.0",
    "@zxing/browser": "^0.1.5",
    "exceljs": "^4.4.0",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.45",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.72.0",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
